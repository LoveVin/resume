{
  "name": "resume",
  "scripts": {
    "dev": "npm run dev:fullstack",
    "dev:fullstack": "parcel src/fullstack.html --open",
    "dev:ai-agent": "parcel src/ai-agent.html --open",
    "clean": "rm -rf .parcel-cache docs/fullstack docs/ai-agent",
    "build": "npm run clean && npm run build:fullstack && npm run build:ai-agent",
    "build:fullstack": "parcel build src/fullstack.html --dist-dir docs/fullstack --public-url ./ --no-cache",
    "build:ai-agent": "parcel build src/ai-agent.html --dist-dir docs/ai-agent --public-url ./ --no-cache"
  },
  "devDependencies": {
    "cssnano": "^4.1.10",
    "parcel": "^2.12.0"
  }
}
